# Live mode: copy to .env.local (git-ignored) and fill in. Leave unset to run on sample data.
# Run sql/setup.sql first. Key-pair authentication only:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out ~/.snowflake/keys/rsa_key.p8 -nocrypt
#   openssl rsa -in ~/.snowflake/keys/rsa_key.p8 -pubout   # then, as an admin:
#   ALTER USER <YOUR_USER> SET RSA_PUBLIC_KEY='<public key body>';
# Keep the private key outside this repository.
SNOWFLAKE_ACCOUNT=<orgname>-<account_name>
SNOWFLAKE_USERNAME=<YOUR_USER>
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/outside/repo/rsa_key.p8

# Defaults match sql/setup.sql; change only if you renamed objects.
# SNOWFLAKE_WAREHOUSE=INSURANCE_SALES_WH
# SNOWFLAKE_DATABASE=INSURANCE_SALES_DB
# SNOWFLAKE_SCHEMA=SALES
# SNOWFLAKE_ROLE=INSURANCE_SALES_DEMO_ROLE        # "View as: Director"
# SNOWFLAKE_REP_ROLE=INSURANCE_SALES_REP_ROLE     # "View as: Rep" (row access policy)
# SNOWFLAKE_AGENT_NAME=INSURANCE_SALES_DB.SALES.INSURANCE_SALES_AGENT
# SNOWFLAKE_BRIEF_MODEL=claude-sonnet-4-5         # model for AI_COMPLETE visit briefs
